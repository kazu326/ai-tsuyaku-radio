[
  {
    "text": "最近、AIにうまく指示するには、長い文章を書かないといけない。",
    "startMs": 0,
    "endMs": 4090,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "そんなイメージ、ありませんか？",
