  "rows": [
    {
      "block": 1,
      "text": "最近、AIにうまく指示するには、長い文章を書かないといけない。",
      "v02StartMs": 280,
      "v03StartMs": 0,
      "endMs": 4169,
      "startAdvanceMs": 280,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 0,
      "displayEndFrame": 121
    },
    {
      "block": 2,
      "text": "そんなイメージ、ありませんか？",
      "v02StartMs": 4339,
      "v03StartMs": 4039,
      "endMs": 5729,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 130,
      "displayStartFrame": 121,
      "displayEndFrame": 172
    },
    {
      "block": 3,
      "text": "条件を細かく書いて、例もたくさん入れて、禁止事項も並べて。",
      "v02StartMs": 6559,
      "v03StartMs": 6259,
      "endMs": 10449,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 188,
      "displayEndFrame": 313
    },
    {
      "block": 4,
      "text": "なんとなく、長く書いた方がAIが賢くなる気がしますよね。",
      "v02StartMs": 11059,
      "v03StartMs": 10759,
      "endMs": 14829,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 323,
      "displayEndFrame": 445
    },
    {
      "block": 5,
      "text": "でも、ここがちょっと面白いところです。",
      "v02StartMs": 15759,
      "v03StartMs": 15459,
      "endMs": 17650,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 464,
      "displayEndFrame": 530
    },
    {
      "block": 6,
      "text": "AIにとって大事なのは、文章の長さそのものではありません。",
      "v02StartMs": 18199,
      "v03StartMs": 17899,
      "endMs": 21830,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 537,
      "displayEndFrame": 655
    },
    {
      "block": 7,
      "text": "「何を目指しているのか」と、",
      "v02StartMs": 22699,
      "v03StartMs": 22399,
      "endMs": 24449,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 672,
      "displayEndFrame": 728
    },
    {
      "block": 8,
      "text": "「判断するために何を知っておく必要があるのか」です。",
      "v02StartMs": 24559,
      "v03StartMs": 24259,
      "endMs": 27849,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 190,
      "displayStartFrame": 728,
      "displayEndFrame": 835
    },
    {
      "block": 9,
      "text": "ちょっと旅行で例えてみますね。",
      "v02StartMs": 28760,
      "v03StartMs": 28460,
      "endMs": 30989,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 854,
      "displayEndFrame": 923
    },
    {
      "block": 10,
      "text": "友だちに、「いい感じの温泉に連れていって」",
      "v02StartMs": 31079,
      "v03StartMs": 30779,
      "endMs": 33749,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 210,
      "displayStartFrame": 923,
      "displayEndFrame": 1010
    },
    {
      "block": 11,
      "text": "だけだと、さすがに困ります。",
      "v02StartMs": 33979,
      "v03StartMs": 33679,
      "endMs": 35789,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 70,
      "displayStartFrame": 1010,
      "displayEndFrame": 1074
    },
    {
      "block": 12,
      "text": "でも、「静かな温泉で、東京から日帰り。",
      "v02StartMs": 36459,
      "v03StartMs": 36159,
      "endMs": 39609,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 1085,
      "displayEndFrame": 1188
    },
    {
      "block": 13,
      "text": "できれば人が少ないところ」",
      "v02StartMs": 40000,
      "v03StartMs": 39700,
      "endMs": 41629,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 1191,
      "displayEndFrame": 1249
    },
    {
      "block": 14,
      "text": "まで分かれば、かなり探しやすくなります。",
      "v02StartMs": 41939,
      "v03StartMs": 41639,
      "endMs": 45209,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 1249,
      "displayEndFrame": 1352
    },
    {
      "block": 15,
      "text": "逆に、服装や朝ごはんや昨日見たテレビの話まで全部渡しても、",
      "v02StartMs": 45360,
      "v03StartMs": 45060,
      "endMs": 49949,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 149,
      "displayStartFrame": 1352,
      "displayEndFrame": 1491
    },
    {
      "block": 16,
      "text": "温泉探しにはあまり関係ありません。",
      "v02StartMs": 50000,
      "v03StartMs": 49700,
      "endMs": 53020,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 249,
      "displayStartFrame": 1491,
      "displayEndFrame": 1582
    },
    {
      "block": 17,
      "text": "AIも似ています。",
      "v02StartMs": 53020,
      "v03StartMs": 52720,
      "endMs": 54129,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 300,
      "displayStartFrame": 1582,
      "displayEndFrame": 1624
    },
    {
      "block": 18,
      "text": "ここ、一回整理しますね。",
      "v02StartMs": 55159,
      "v03StartMs": 54859,
      "endMs": 57389,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 0,
      "displayStartFrame": 1646,
      "displayEndFrame": 1717
    },
    {
      "block": 19,
      "text": "大事なのは、たくさん指示することではなく、",
      "v02StartMs": 57539,
      "v03StartMs": 57239,
      "endMs": 60670,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 150,
      "displayStartFrame": 1717,
      "displayEndFrame": 1816
    },
    {
      "block": 20,
      "text": "目的と、必要な情報をちゃんと共有すること。",
      "v02StartMs": 60840,
      "v03StartMs": 60540,
      "endMs": 64449,
      "startAdvanceMs": 300,
      "overlapWithPreviousMs": 130,
      "displayStartFrame": 1816,
      "displayEndFrame": 1933
    },
    {
      "block": 21,
      "text": "そして最初から完璧に伝えようとしなくても大丈夫です。",
